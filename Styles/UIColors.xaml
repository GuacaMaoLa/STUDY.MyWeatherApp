<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--primary Background Colors-->
    <SolidColorBrush x:Key="primaryBackgroundColor" Color="#0A003A"/>
    
    <!--Secondary Background Colors-->
    <Color x:Key="secondaryBackgroundColor1">#301847</Color>
    <Color x:Key="secondaryBackgroundColor2">#C10214</Color>
    
    <!--Button Colors-->
    <SolidColorBrush x:Key="hoverOverButtonColor" Color="#ABCFFF"/>
    <SolidColorBrush x:Key="isClickedButtonColor" Color="#ABC0E0"/>
</ResourceDictionary>
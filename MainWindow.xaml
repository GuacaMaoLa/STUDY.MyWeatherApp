<Window x:Class="LEARN_MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LEARN_MVVM"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}">

    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>

    <Border BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <!--Navigation Menu-->
                <ColumnDefinition Width="150"/>
                <!--Content Section-->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!--Navigation Menu-->
            <Border CornerRadius="10,0,0,10"
                    Grid.Column="0">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.7">
                        <GradientStop Color="{StaticResource secondaryBackgroundColor1}" Offset="0.0"/>
                        <GradientStop Color="{StaticResource secondaryBackgroundColor2}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel>
                    <ui:TextBlock Grid.Column="0"
                    Text="MyWeatherApp"
                    FontTypography="Title"
                    FontSize="18"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="10,10,0,0"/>

                    <RadioButton Style="{StaticResource menuButton}"
                                 FontSize="16"
                                 Command="{Binding HomeViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WeatherRain20"/>
                            <TextBlock Text="WeatherApp"/>
                        </StackPanel>                        
                    </RadioButton>
                    
                    <RadioButton Style="{StaticResource menuButton}"
                     Content="History"
                     Height="50"
                     Foreground="White"
                     FontSize="16" 
                     Command="{Binding HistoryViewCommand}"/>

                    <RadioButton Style="{StaticResource menuButton}"
                                 FontSize="16"
                                 Command="{Binding NotifyAndreCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Chat16"/>
                            <TextBlock Text="NotifyAndre"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
            
            <!--Content View-->
            <Border CornerRadius="0,10,10,0"
                    Grid.Column="1"
                    Background="{StaticResource primaryBackgroundColor}">

                <Grid>
                    <Grid.RowDefinitions>
                        <!--Control Bar-->
                        <RowDefinition Height="25"/>
                        <!--Header-->
                        <RowDefinition Height="35"/>
                        <!--Content section-->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="pnlControlBar"
                            Grid.Row="0"
                            Orientation="Horizontal"
                            FlowDirection="RightToLeft"
                            Background="Transparent"
                            Margin="0,0,5,0"
                            MouseLeftButtonDown="plnControlBar_MouseLeftButtonDown">
                    </StackPanel>

                    <ContentControl
                        Grid.Row="2"
                        Margin="5"
                        Content="{Binding CurrentView}"/>
                </Grid>
                
            </Border>
            
            <ui:SnackbarPresenter Grid.Column="1" Grid.Row="1" x:Name="SnackbarPresenter"/>
        
        </Grid>
    </Border>
</Window>